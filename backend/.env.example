DATA_DIR=data
ALLOWED_ORIGINS=["http://localhost:3000"]
# Local real providers (install Ollama and pull both models first).
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# To use OpenAI, change both provider values to openai and set model names:
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
# To use Gemini, set both providers to gemini and use these models:
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY=replace-with-your-key
# To use OpenRouter, set both providers to openrouter:
# LLM_MODEL=google/gemini-2.5-flash
# EMBEDDING_MODEL=openai/text-embedding-3-small
# OPEN_ROUTER_API_KEY=replace-with-your-key
# OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_FILE_BYTES=10485760
MAX_FILES=10
MAX_EXTRACTED_CHARS=2000000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_COUNT=5
HISTORY_MESSAGES=8
CONTEXT_WINDOW=8192
MAX_OUTPUT_TOKENS=1024
PROVIDER_TIMEOUT=120
